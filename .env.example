# ── Required ────────────────────────────────────────────────────────────────
# 32+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Optional integrations (features degrade gracefully when empty) ──────────
# Google sign-in (OAuth 2.0 web client). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gemini — AI coach. Empty = rule-based commentary only.
GEMINI_API_KEY=
# Resend — password-reset e-mails. Empty = reset links are printed to the backend log.
RESEND_API_KEY=
# Web Push. Generate a pair: cd backend && python -m app.cli.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Local database (docker compose) ─────────────────────────────────────────
POSTGRES_USER=eloquence
POSTGRES_PASSWORD=eloquence_dev
POSTGRES_DB=eloquence
